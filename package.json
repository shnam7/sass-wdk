{
    "name": "sass-wdk",
    "version": "1.2.0",
    "description": "Sass web development kit - A comprehensive library of functions, mixins, and utilities for Sass/SCSS development",
    "type": "module",
    "keywords": [
        "sass",
        "scss",
        "sass-functions",
        "sass-mixins",
        "sass-utilities",
        "media-queries",
        "theming",
        "design-system",
        "design-tokens",
        "color-utils"
    ],
    "homepage": "https://github.com/shnam7/sass-wdk#readme",
    "bugs": {
        "url": "https://github.com/shnam7/sass-wdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shnam7/sass-wdk.git",
        "directory": "."
    },
    "license": "MIT",
    "author": {
        "name": "Robin Nam",
        "email": "shnam7@gmail.com",
        "url": "https://github.com/shnam7"
    },
    "sass": "wdk/_index.scss",
    "style": "wdk/_index.scss",
    "exports": {
        ".": "./wdk/_index.scss",
        "./wdk/*": "./wdk/*.scss",
        "./*": "./wdk/*.scss"
    },
    "files": [
        "wdk",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "pnpm run lint",
        "dev": "vitest",
        "lint": "stylelint --config stylelint.config.js wdk/**/*.scss",
        "lint:fix": "stylelint --config stylelint.config.js wdk/**/*.scss --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare-to-commit": "pnpm build && pnpm test",
        "prepublishOnly": "pnpm run test",
        "npm-dry-run": "npm publish --dry-run",
        "--clean": "rimraf __output",
        "--sass-build": "sass -I. --no-source-map --no-error-css test:__output",
        "--sass-watch": "sass -w -I. --no-source-map test:__output",
        "--watch": "chokidar \"./{wdk,test}/**/*.scss\" -c \"npm run test\""
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "peerDependencies": {
        "sass": "^1.50.0"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "rimraf": "^6.1.2",
        "sass": "^1.97.2",
        "sass-true": "^10.1.0",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.1",
        "stylelint-config-standard-scss": "^16.0.0",
        "vitest": "^4.0.16"
    },
    "packageManager": "pnpm@10.27.0",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
